# Distributed Query & Storage Engine (DQSE) Environment Template
# Copy to .env for local overrides; never commit real secrets.

DQSE_DATA_DIR=.local_data/warehouse
DQSE_CATALOG_DB=.local_data/catalog.sqlite3
DQSE_SPILL_DIR=.local_data/spill
DQSE_AUDIT_LOG=.local_data/audit.jsonl

# Coordinator HTTP & UI port
DQSE_COORDINATOR_HOST=127.0.0.1
DQSE_COORDINATOR_PORT=8090

# Comma-separated gRPC worker endpoints (local multi-process default)
DQSE_WORKERS=worker-1=127.0.0.1:18091,worker-2=127.0.0.1:18092,worker-3=127.0.0.1:18093

# Worker memory & cache limits
DQSE_WORKER_MAX_MEM_MB=128
DQSE_CACHE_MAX_MB=64
DQSE_TASK_LEASE_MS=15000
DQSE_MAX_TASK_RETRIES=2

# Development API keys (replace with secret manager values in production)
DQSE_API_KEY_ADMIN=dev-admin-key-change-me
DQSE_API_KEY_ANALYST=dev-analyst-key-change-me
DQSE_API_KEY_VIEWER=dev-viewer-key-change-me

# Optional OpenTelemetry OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ARCH=arm64
