# Container-buildable Rust + Tonic + Apache Arrow + DataFusion companion worker
FROM rust:1.86.0-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY schemas ./schemas
COPY rust_worker ./rust_worker

WORKDIR /build/rust_worker
RUN cargo build --release

FROM debian:12.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home dqse

COPY --from=builder /build/rust_worker/target/release/dqse-rust-worker /usr/local/bin/dqse-rust-worker
USER dqse
EXPOSE 18094
ENTRYPOINT ["/usr/local/bin/dqse-rust-worker"]
